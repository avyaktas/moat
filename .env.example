# Copy to .env and fill in. Never commit .env - it is gitignored.

# Required. Postgres connection string. Managed providers hand out
# postgresql:// and the app rewrites the driver prefix itself, so either form
# works.
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/moat

# Required for /brief and /report. Every other endpoint works without it.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Database used by pytest. Blank falls back to a local default, so a
# fresh clone can run the suite without setting anything.
TEST_DATABASE_URL=

# Optional. Protects ?refresh=, which forces a paid report regeneration.
# Unset means anyone who knows the URL can trigger it - fine locally, not for
# a public deployment.
REFRESH_TOKEN=

# Optional. Rate limiting for the two endpoints that spend money.
# RATE_LIMIT_BURST=10
# RATE_LIMIT_PER_MINUTE=20

# Optional. DEBUG, INFO, WARNING. Defaults to INFO.
# LOG_LEVEL=INFO
