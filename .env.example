# .env.example  (committed, documents the shape)

# Required. Managed providers hand out postgresql:// and the app rewrites the
# driver prefix itself, so either form works.
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/moat

# Required for /brief and /report; everything else works without it.
ANTHROPIC_API_KEY=

# Optional. Blank falls back to the config default, so a fresh clone can run
# the tests without setting anything.
TEST_DATABASE_URL=

# Optional. Protects ?refresh=, which forces a paid report regeneration.
# Unset means anyone can trigger it - fine locally, not for a public deploy.
REFRESH_TOKEN=

# Optional rate limiting for the two endpoints that cost money.
# RATE_LIMIT_BURST=10
# RATE_LIMIT_PER_MINUTE=20

# yfinance needs no key
